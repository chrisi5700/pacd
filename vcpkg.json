{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "pacd",
  "version": "0.1.0",
  "description": "Primitive-approximate convex decomposition of triangle meshes into collision proxies",
